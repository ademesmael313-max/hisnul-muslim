{
  "1": "ከእንቅልፍ ሲነሳ",
  "2": "ልብስ ሲለብስ",
  "3": "አዲስ ልብስ ሲለብስ",
  "4": "አዲስ ልብስ ለለበሰ ሰው የሚደረግ ዱዓ",
  "5": "ልብስ ሲያወልቅ",
  "6": "መታጠቢያ ቤት ሲገባ",
  "7": "ከመታጠቢያ ቤት ሲወጣ",
  "8": "ውዱእ ከመጀመሩ በፊት",
  "9": "ውዱእን ከጨረሰ በኋላ",
  "10": "ከቤት ሲወጣ",
  "11": "ወደ ቤት ሲገባ",
  "12": "ወደ መስጊድ ሲሄድ",
  "13": "መስጊድ ሲገባ",
  "14": "ከመስጊድ ሲወጣ",
  "15": "አዛንን ሲሰማ",
  "16": "ሶላትን ሲጀምር",
  "17": "በሩኩዕ ጊዜ",
  "18": "ከሩኩዕ ሲነሳ",
  "19": "በሱጁድ ጊዜ",
  "20": "በሁለቱ ሱጁዶች መካከል",
  "21": "የቁርአን ሱጁድ (ሰጅደ ቲላዋ)",
  "22": "ተሸሁድ",
  "23": "ከተሸሁድ በኋላ በነቢዩ ላይ ሰላት ማድረግ",
  "24": "ከመጨረሻው ተሸሁድ በኋላ፣ ሰላም ከመላለሱ በፊት",
  "25": "ሰላም ካስተላለፈ በኋላ የሚባል ዚክር",
  "26": "የኢስቲኻራ ዱዓ",
  "27": "የጠዋትና የማታ ዚክር",
  "28": "ከመተኛት በፊት የሚባል",
  "29": "በሌሊት እየተመላለሰ ሲነቃ",
  "30": "በእንቅልፍ ላይ ፍርሃት፣ ብቸኝነት ወይም ጭንቀት ሲሰማው",
  "31": "መጥፎ ሕልም ሲያይ",
  "32": "በዊትር ሶላት የቁኑት ዱዓ",
  "33": "ከዊትር ሶላት በኋላ ወዲያውኑ የሚባል",
  "34": "በጭንቀትና በሐዘን ጊዜ",
  "35": "በጠባባይ ጊዜ",
  "36": "ጠላትን ወይም ሥልጣን ያለውን ሰው ሲያገኝ",
  "37": "ከገዢዎች ግፍ ለመጠበቅ",
  "38": "በጠላት ላይ",
  "39": "ሰዎች ሊጎዱት ሲፈራ",
  "40": "በእምነቱ ጥርጣሬ ሲያድርበት",
  "41": "ዕዳን ለመክፈል",
  "42": "በሶላትና በንባብ ጊዜ የሰይጣን ሀሳብ ሲመጣ",
  "43": "ነገር ሲከብድበት",
  "44": "ኃጢአት ሲሠራ",
  "45": "ሰይጣንንና ሀሳቦቹን ለማባረር",
  "46": "የማይወደው ነገር ሲያጋጥመው ወይም ያሰበው ሳይሳካ ሲቀር",
  "47": "ልጅ ሲወለድ የሚባልና መመለሻው",
  "48": "ልጆችን በአላህ ጥበቃ ማድረግ",
  "49": "በሽተኛን ሲጠይቅ",
  "50": "በሽተኛን የመጠየቅ ሽልማት",
  "51": "ከሕይወት ተስፋ የቆረጠ በሽተኛ የሚያደርገው ዱዓ",
  "52": "ለሚሞት ሰው የሚደረግ ማስተማር",
  "53": "አደጋ ሲደርስ",
  "54": "የሞተ ሰውን ዓይን ሲዘጋ",
  "55": "በቀብር ሶላት ለሟች የሚደረግ ዱዓ",
  "56": "በቀብር ሶላት ለልጅ የሚደረግ ዱዓ",
  "57": "ለተለቀሰ ሰው ማጽናናት",
  "58": "ሟችን በመቃብር ሲያስቀምጡ",
  "59": "ከቀብር በኋላ",
  "60": "መቃብርን ሲጎበኝ",
  "61": "ነፋስ ሲነፍ",
  "62": "ነጎድጓድ ሲሰማ",
  "63": "ዝናብ ለመጠየቅ የሚደረግ ዱዓ",
  "64": "ዝናብ ሲዘንብ",
  "65": "ከዝናብ በኋላ",
  "66": "ዝናብ እንዲቆጠብ መጠየቅ",
  "67": "አዲስ ጨረቃን ሲያይ",
  "68": "ጾም ሲፈታ",
  "69": "ከመመገብ በፊት",
  "70": "ከመመገብ በኋላ",
  "71": "እንግዳው ለአስተናጋጁ የሚያደርገው ዱዓ",
  "72": "መጠጥ ለሰጠህ ሰው",
  "73": "በሰው ቤት ጾም ሲፈታ",
  "74": "ጾም ያለበት ሰው ምግብ ሲቀርብለትና ሳይፈታ ሲቀር",
  "75": "ጾም ያለበትን ሰው ሲያንገላታ",
  "76": "የመጀመሪያውን ፍሬ ሲያይ",
  "77": "ሲያስነጥስ",
  "78": "ከኢስላም ውጪ ያለ ሰው አላህን አመስግኖ ሲያስነጥስ",
  "79": "ለአዲስ ተጋቢዎች",
  "80": "በሠርግ ሌሊት ወይም እንስሳ ሲገዛ የሚደረግ ዱዓ",
  "81": "ከግብረ ሥጋ ግንኙነት በፊት",
  "82": "ሲበሳጭ",
  "83": "በፈተና ውስጥ ያለን ሰው ሲያይ",
  "84": "በመሰብሰቢያ ሲቀመጥ",
  "85": "የመሰብሰቢያ ካፋራ",
  "86": "አላህ ይማርህ ለሚል ሰው መመለስ",
  "87": "መልካም ለሠራልህ ሰው የሚደረግ ዱዓ",
  "88": "ከዳጃል መጠበቅን መጠየቅ",
  "89": "ለአላህ ሲል «እወድሃለሁ» ለሚል ሰው",
  "90": "ከሀብቱ ሊያካፍልህ ለሚል ሰው",
  "91": "ዕዳ ሲከፈል ለወሳቡ ሰው",
  "92": "ከሺርክ ፍርሃት",
  "93": "«አላህ ይባርክህ» ለሚል ሰው መመለሻ",
  "94": "ከመጥፎ ምልክት (ጥንቆላ) መጠበቅ",
  "95": "ተሽከርካሪ ወይም እንስሳ ሲወጣ",
  "96": "ለጉዞ የሚደረግ ዱዓ",
  "97": "ከተማ ወይም መንደር ሲገባ",
  "98": "ገበያ ሲገባ",
  "99": "ተሽከርካሪ ወይም እንስሳ ሲያንሸራትት",
  "100": "ተጓዡ ለተወው ሰው የሚያደርገው ዱዓ",
  "101": "በቤት ያለው ሰው ለተጓዡ የሚያደረገው ዱዓ",
  "102": "በጉዞ ላይ ሲወጣና ሲወርድ የሚባል ዚክር",
  "103": "ተጓዡ ጎህ ሲነጋ የሚያደርገው ዱዓ",
  "104": "በጉዞ ማረፊያ ቦታ ሲያርፍ",
  "105": "ከጉዞ ሲመለስ",
  "106": "የሚያስደስት ወይም የሚያሳዝን ነገር ሲያጋጥመው",
  "107": "በነቢዩ (ሰ.ዐ.ወ) ላይ ሰላት ማድረግን ማበረታታት",
  "108": "ሰላምን ማሰራጨትን ማበረታታት",
  "109": "ከኢስላም ውጪ ላለ ሰው ሰላም እንዴት መመለስ",
  "110": "ዶሮ ሲጮህ ወይም አህያ ሲያጉረምርም",
  "111": "ሌሊት ውሻ ሲጮህ",
  "112": "ለሰደብከው ሰው የሚደረግ ዱዓ",
  "113": "ሙስሊምን ሲያመሰግን",
  "114": "ሲመሰገን የሚባል",
  "115": "የሐጅና የዑምራ ተልቢያ",
  "116": "ጥቁሩን ድንጋይ ሲያልፍ ተክቢር ማለት",
  "117": "በየመናዊው ማዕዘንና በጥቁሩ ድንጋይ መካከል",
  "118": "በሰፋና በመርዋ ላይ",
  "119": "በዓረፋ ቀን",
  "120": "በሙዝደሊፋ በተከበረው ቦታ",
  "121": "በሚና ጠጠሮችን ሲወረወር",
  "122": "በሚደነቅ ወይም በሚገርም ጊዜ",
  "123": "የሚያስደስት ዜና ሲሰማ",
  "124": "በሰውነት ላይ ህመም ሲሰማ",
  "125": "በዓይን ጥብቆ ሊያጠፋ ሲፈራ",
  "126": "ሲደነግጥ",
  "127": "እንስሳ ሲያርድ ወይም መስዋዕት ሲያቀርብ",
  "128": "የአላገን ሰይጣኖች ሴራ ለማክሸፍ",
  "129": "ተውባና ምሕረት መጠየቅ",
  "130": "የተስቢሕ፣ የተሕሚድ፣ የተህሊልና የተክቢር ልዕልና",
  "131": "ነቢዩ (ሰ.ዐ.ወ) እንዴት ተስቢሕ ያደርጉ ነበር",
  "132": "የጋራ ሕይወት መልካም ስነምግባርና የበጎ ነገሮች ዓይነቶች"
}
