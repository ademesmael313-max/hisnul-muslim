    <!-- About -->
    <string name="about_title">ስለ መተግበሪያው</string>
    <string name="about_book">ስለ መጽሐፉ</string>
    <string name="about_book_body">ሂስኑል ሙስሊም (የሙስሊሙ ምሽግ) በሰዒድ ቢን ዓሊ ቢን ወህፍ አል-ቀህጣኒ የተዘጋጀ የዕለት ተዕለት ዱዓዎችና ዚክሮች ስብስብ ነው። መጽሐፉ ከቁርአንና ከትክክለኛው ሱና የተወሱ ዱዓዎችን በምዕራፍ ያሰባስባል።</string>
    <string name="about_content">ስለ ይዘቱ</string>
    <string name="about_content_body">በዚህ መተግበሪያ ውስጥ 132 ምዕራፍና 267 ዱዓ አሉ። የዐረብኛው ጽሑፍ ከሂስኑል ሙስሊም ምንጭ የተወሰደ ሲሆን፣ የአማርኛ ትርጉሙ ትርጉም-ተኮር ነው። ትርጉሙ ረቂቅ ሊሆን ስለሚችል ለንባብና ለመረዳት ያገለግላል፤ የመጨረሻው ማጣቀሻ የዐረብኛው ጽሑፍ ነው።</string>
    <string name="about_privacy">ብስቲና</string>
    <string name="about_privacy_body">መተግበሪያው ምንም ዓይነት መረጃ አይሰበስብም፤ ኢንተርኔት አይጠቀምም። ተወዳጆችና ቅንብሮች በስልኩ ላይ ብቻ ይቀመጣሉ።</string>
    <string name="about_credits">ምስጋና</string>
    <string name="about_credits_body">የአማርኛ ፊደል፦ Noto Sans Ethiopic (SIL Open Font License 1.1)። የዐረብኛ ጽሑፍ ምንጭ፦ hisnmuslim.com የዱዓ ውሂብ ስብስብ።</string>
